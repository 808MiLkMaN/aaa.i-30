  "repository": {
    "type": "git",
    "url": "https://github.com/yourusername/agent-build-system.git"
  },
  "bugs": {
    "url": "https://github.com/yourusername/agent-build-system/issues"
  },
  "homepage": "https://github.com/yourusername/agent-build-system#readme",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "yaml": "^2.3.4"
  },
